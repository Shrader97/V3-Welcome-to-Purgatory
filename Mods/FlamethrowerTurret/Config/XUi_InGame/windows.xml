<?xml version="1.0" encoding="UTF-8"?>
<patch>
	<!-- A dedicated controller owns this row, so the amount does not depend on the
	     assemble window's vanilla itemstat bindings. It overlays the otherwise empty row 3. -->
	<append xpath="/windows/window[@name='windowAssembleDrone']//rect[@name='stats']">
		<rect name="flameFuelAmount" depth="20" pos="0,-60" width="380" height="33" visible="{showflamefuel}" controller="DroneFlameFuelDisplayController, Flamethrower turret">
			<sprite depth="8" sprite="menu_empty3px" height="33" color="[black]" type="sliced" fillcenter="false" />
			<sprite depth="1" color="[darkestGrey]" pos="0,-1" height="31" type="sliced" />
			<label depth="9" pos="15,-3" width="350" font_size="26" text="{flamefueltitle}" justify="left" color="[white]" />
			<label depth="9" pos="15,-3" width="350" font_size="26" text="{flamefuel}" justify="right" color="[selectedColor]" />
		</rect>

		<rect name="btnFlameRefuel" depth="20" pos="0,-180" width="380" height="34" visible="{showflamefuel}" controller="DroneFlameRefuelController, Flamethrower turret">
			<sprite depth="4" name="backgroundMain" sprite="menu_empty3px" color="[black]" type="sliced" fillcenter="false" />
			<rect depth="3" name="background" pos="3,-3" width="375" height="28">
				<button name="clickable" sprite="menu_empty" defaultcolor="[mediumGrey]" disabledcolor="[mediumGrey]" hoversprite="ui_game_select_row" hovercolor="[white]" type="sliced" hoverscale="1.0" sound="[paging_click]" />
				<sprite depth="2" name="windowIconShadow1" width="24" height="24" pos="126,-2" sprite="ui_game_symbol_gas" color="[black_half_alpha]"/>
				<sprite depth="2" name="windowIconShadow2" width="24" height="24" pos="124,-2" sprite="ui_game_symbol_gas" color="[black_half_alpha]"/>
				<sprite depth="2" name="windowIconShadow3" width="24" height="24" pos="124,0" sprite="ui_game_symbol_gas" color="[black_half_alpha]"/>
				<sprite depth="2" name="windowIconShadow4" width="24" height="24" pos="126,0" sprite="ui_game_symbol_gas" color="[black_half_alpha]"/>
				<sprite depth="2" name="windowIcon" width="24" height="24" pos="125,-1" sprite="ui_game_symbol_gas"/>
				<label depth="2" name="windowName" pos="160,-1" width="212" justify="left" text="REFUEL" text_key="xuiRefuel" font_size="28" />
			</rect>
		</rect>
	</append>
</patch>
