<configs>
	<append xpath="/xui/window_group[@name='toolbelt']">
		<window name="remsFishingCenter"/>
		<window name="remsFishingFight"/>
		<window name="remsFishingCatch"/>
	</append>
	<!-- wip-hud:begin (generated by Tools/merge_wip.py (hud)) -->
	<!-- REMS Fishing HUD module: the 1.0 HUD windows ride in the toolbelt group (open during normal play) and the 0.1 ones
	     go. The Fishing Journal is its own modal window group. -->
	<remove xpath="/xui/window_group[@name='toolbelt']/window[@name='remsFishingCenter' or @name='remsFishingFight' or @name='remsFishingCatch']"/>
	<append xpath="/xui/window_group[@name='toolbelt']">
		<window name="remsFishingAim"/>
		<window name="remsFishingFightPanel"/>
		<window name="remsFishingCard"/>
	</append>
	<append xpath="/xui">
		<window_group name="remsFishingJournal" close_compass_on_open="true">
			<window name="remsFishingJournal"/>
		</window_group>
	</append>
	<!-- wip-hud:end -->
	<!-- wip-jobs:begin (generated by Tools/merge_wip.py (jobs)) -->
	<!-- the Fishing Jobs board, opened from the trader's "Got any fishing work?" line -->
	<append xpath="/xui">
		<window_group name="remsFishingJobs" close_compass_on_open="true">
			<window name="remsFishingJobs" />
		</window_group>
	</append>
	<!-- the "Fishing jobs" HUD tracker sits with the vanilla quest tracker in the toolbelt group -->
	<append xpath="/xui/window_group[@name='toolbelt']">
		<window name="remsFishingJobsTracker" />
	</append>
	<!-- wip-jobs:end -->
	<!-- trap-window: the Fishing Trap's own window group (XUiC_REMSTrapWindowGroup), laid out like the Dew Collector's -->
	<append xpath="/xui">
		<window_group name="remsFishingTrap" left_panel_valign_top="false" controller="REMS.Fishing.REMSTrapWindowGroup, REMS.Fishing" close_compass_on_open="true" defaultselected="0">
			<window name="windowREMSTrapMods" />
			<window name="windowREMSTrap" />
			<window name="windowREMSTrapBait" />
			<window name="windowREMSTrapLife" />
			<window name="windowNonPagingHeader" />
		</window_group>
	</append>
	<!-- rod-tackle: the rod's Tackle panel joins the vanilla Modify window group (XUiC_REMSRodTackle hides it for anything but a REMS rod) -->
	<append xpath="/xui/window_group[@name='assemble']">
		<window name="windowREMSRodTackle" />
	</append>
</configs>
