<configs>
	<!-- wip-skill:begin (generated by Tools/merge_wip.py (skill)) -->
	<!-- ===================================================================================================== -->
	<!-- Rod mods (spec 4.3): vanilla attachments that fit only the two fishing rods (both are tagged          -->
	<!-- remsFishingRod) and go in the rods' ModSlots. One mod per type: the game refuses a second mod that    -->
	<!-- shares a modifier tag (XUiC_ItemPartStack / XUiC_ItemStack test ModifierTags), exactly like vanilla.  -->
	<!-- Types: reel, line, grip, rig, tip. The effects are applied by REMS.Fishing, which finds a fitted mod   -->
	<!-- by item name (FishingTackle.HasMod); the numbers live in RodModEffects and the core.                 -->
	<!-- Placeholder icons: vanilla sprites with a tint until the real icons are made (REPORT.md).            -->
	<!-- ===================================================================================================== -->
	<append xpath="/item_modifiers">
		<!-- Reel -->
		<item_modifier name="remsRodModSmoothDrag" installable_tags="remsFishingRod" modifier_tags="reel" blocked_tags="noMods" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="CreativeMode" value="Player"/>
			<property name="Tags" value="scrap100,remsTackle,remsRodMod"/>
			<property name="CustomIcon" value="resourceElectricParts"/>
			<property name="CustomIconTint" value="200,200,215"/>
			<property name="DescriptionKey" value="remsRodModSmoothDragDesc"/>
			<property name="EconomicValue" value="100"/>
			<property name="UnlockedBy" value="craftingFishing"/>
		</item_modifier>

		<!-- Line: braid, fluorocarbon and the wire leader share the line slot -->
		<item_modifier name="remsRodModBraidedLine" installable_tags="remsFishingRod" modifier_tags="line" blocked_tags="noMods" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="CreativeMode" value="Player"/>
			<property name="Tags" value="scrap100,remsTackle,remsRodMod"/>
			<property name="CustomIcon" value="modGunBowPolymerString"/>
			<property name="DescriptionKey" value="remsRodModBraidedLineDesc"/>
			<property name="EconomicValue" value="120"/>
			<property name="UnlockedBy" value="craftingFishing"/>
		</item_modifier>
		<item_modifier name="remsRodModFluorocarbon" installable_tags="remsFishingRod" modifier_tags="line" blocked_tags="noMods" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="CreativeMode" value="Player"/>
			<property name="Tags" value="scrap100,remsTackle,remsRodMod"/>
			<property name="CustomIcon" value="modGunBowPolymerString"/>
			<property name="CustomIconTint" value="200,235,255"/>
			<property name="DescriptionKey" value="remsRodModFluorocarbonDesc"/>
			<property name="EconomicValue" value="160"/>
			<property name="UnlockedBy" value="craftingFishing"/>
		</item_modifier>
		<item_modifier name="remsRodModWireLeader" installable_tags="remsFishingRod" modifier_tags="line" blocked_tags="noMods" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="CreativeMode" value="Player"/>
			<property name="Tags" value="scrap100,remsTackle,remsRodMod"/>
			<property name="CustomIcon" value="modGunBowPolymerString"/>
			<property name="CustomIconTint" value="160,160,165"/>
			<property name="DescriptionKey" value="remsRodModWireLeaderDesc"/>
			<property name="EconomicValue" value="140"/>
			<property name="UnlockedBy" value="craftingFishing"/>
		</item_modifier>

		<!-- Grip -->
		<item_modifier name="remsRodModCorkGrip" installable_tags="remsFishingRod" modifier_tags="grip" blocked_tags="noMods" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="CreativeMode" value="Player"/>
			<property name="Tags" value="scrap100,remsTackle,remsRodMod"/>
			<property name="CustomIcon" value="modMeleeErgonomicGrip"/>
			<property name="CustomIconTint" value="215,170,110"/>
			<property name="DescriptionKey" value="remsRodModCorkGripDesc"/>
			<property name="EconomicValue" value="60"/>
			<property name="UnlockedBy" value="craftingFishing"/>
		</item_modifier>

		<!-- Rig: the slip float and the bottom sinker share the rig slot -->
		<item_modifier name="remsRodModSlipFloat" installable_tags="remsFishingRod" modifier_tags="rig" blocked_tags="noMods" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="CreativeMode" value="Player"/>
			<property name="Tags" value="scrap100,remsTackle,remsRodMod"/>
			<property name="CustomIcon" value="lightCeilingBulbSocketWhite"/>
			<property name="CustomIconTint" value="235,90,60"/>
			<property name="DescriptionKey" value="remsRodModSlipFloatDesc"/>
			<property name="EconomicValue" value="80"/>
			<property name="UnlockedBy" value="craftingFishing"/>
		</item_modifier>
		<item_modifier name="remsRodModBottomSinker" installable_tags="remsFishingRod" modifier_tags="rig" blocked_tags="noMods" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="CreativeMode" value="Player"/>
			<property name="Tags" value="scrap100,remsTackle,remsRodMod"/>
			<property name="CustomIcon" value="resourceFishingWeight"/>
			<property name="DescriptionKey" value="remsRodModBottomSinkerDesc"/>
			<property name="EconomicValue" value="90"/>
			<property name="UnlockedBy" value="craftingFishing"/>
		</item_modifier>

		<!-- Tip -->
		<item_modifier name="remsRodModBiteBell" installable_tags="remsFishingRod" modifier_tags="tip" blocked_tags="noMods" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="CreativeMode" value="Player"/>
			<property name="Tags" value="scrap100,remsTackle,remsRodMod"/>
			<property name="CustomIcon" value="churchBell"/>
			<property name="CustomIconTint" value="235,200,110"/>
			<property name="DescriptionKey" value="remsRodModBiteBellDesc"/>
			<property name="EconomicValue" value="180"/>
			<property name="UnlockedBy" value="craftingFishing"/>
		</item_modifier>
	</append>

	<!-- ===================================================================================================== -->
	<!-- Keep weapon/tool mods out of the rods. The rods carry the "tool" tag, and a few vanilla mods install  -->
	<!-- on any "tool" (The Hunter, Rad Remover, Tempered Blade, Diamond Tip, Buttkick 3000/4000, the          -->
	<!-- Decapitizer). Their blocked_tags gain remsFishingRod (ItemClassModifier.DisallowedTags). Dyes are      -->
	<!-- left alone so the rods keep their dye slot. Mods without blocked_tags get the attribute first.        -->
	<!-- ===================================================================================================== -->
	<append xpath="/item_modifiers/item_modifier[contains(concat(',',@installable_tags,','),',tool,') and not(contains(@modifier_tags,'dye')) and @blocked_tags]/@blocked_tags">,remsFishingRod</append>
	<setattribute xpath="/item_modifiers/item_modifier[contains(concat(',',@installable_tags,','),',tool,') and not(contains(@modifier_tags,'dye')) and not(@blocked_tags)]" name="blocked_tags">remsFishingRod</setattribute>
	<!-- wip-skill:end -->
	<!-- wip-traders:begin (generated by Tools/merge_wip.py (traders)) -->
	<!-- Rod mods (skill module item_modifiers). Their values (60-180, spec) stay as trader prices (x3: 180-540 dukes,
	     against 1,200 for a 400-EV vanilla mod) and they sell back like vanilla mods. Two recipes paid far more than
	     their materials: the Bottom Sinker (20 scrap lead + 2 scrap iron = 22 EV, x4.09) and the Bite Bell (10 brass,
	     1 spring, 1 forged steel = 92 EV, x1.96). Their sale is trimmed to about 1.5x the materials (vanilla's
	     craftable mods sell for 0.5-1.7x theirs). ItemClassModifier inherits ItemClass.Init, which parses
	     EconomicSellScale and TraderStageTemplate. Trader visibility follows the Fishing level that unlocks each mod:
	     Cork Grip 8 (always), Slip Float 12 / Smooth Drag 14 / Bottom Sinker 18 (stage 10+), Braided Line 24 /
	     Wire Leader 28 (20+), Fluorocarbon 33 (30+), Bite Bell 40 (40+). Appended: the last property of a name wins. -->
	<append xpath="/item_modifiers/item_modifier[@name='remsRodModSlipFloat']">
		<property name="TraderStageTemplate" value="remsFishingStage10"/>
	</append>
	<append xpath="/item_modifiers/item_modifier[@name='remsRodModSmoothDrag']">
		<property name="TraderStageTemplate" value="remsFishingStage10"/>
	</append>
	<append xpath="/item_modifiers/item_modifier[@name='remsRodModBottomSinker']">
		<property name="EconomicSellScale" value="0.35"/>
		<property name="TraderStageTemplate" value="remsFishingStage10"/>
	</append>
	<append xpath="/item_modifiers/item_modifier[@name='remsRodModBraidedLine']">
		<property name="TraderStageTemplate" value="remsFishingStage20"/>
	</append>
	<append xpath="/item_modifiers/item_modifier[@name='remsRodModWireLeader']">
		<property name="TraderStageTemplate" value="remsFishingStage20"/>
	</append>
	<append xpath="/item_modifiers/item_modifier[@name='remsRodModFluorocarbon']">
		<property name="TraderStageTemplate" value="remsFishingStage30"/>
	</append>
	<append xpath="/item_modifiers/item_modifier[@name='remsRodModBiteBell']">
		<property name="EconomicSellScale" value="0.75"/>
		<property name="TraderStageTemplate" value="remsFishingStage40"/>
	</append>
	<!-- wip-traders:end -->
	<!-- icons:begin (generated by Tools/import_icons.py) -->
	<set xpath="/item_modifiers/item_modifier[@name='remsRodModSmoothDrag']/property[@name='CustomIcon']/@value">remsRodModSmoothDrag</set>
	<remove xpath="/item_modifiers/item_modifier[@name='remsRodModSmoothDrag']/property[@name='CustomIconTint']" />
	<set xpath="/item_modifiers/item_modifier[@name='remsRodModBraidedLine']/property[@name='CustomIcon']/@value">remsRodModBraidedLine</set>
	<set xpath="/item_modifiers/item_modifier[@name='remsRodModFluorocarbon']/property[@name='CustomIcon']/@value">remsRodModFluorocarbon</set>
	<remove xpath="/item_modifiers/item_modifier[@name='remsRodModFluorocarbon']/property[@name='CustomIconTint']" />
	<set xpath="/item_modifiers/item_modifier[@name='remsRodModWireLeader']/property[@name='CustomIcon']/@value">remsRodModWireLeader</set>
	<remove xpath="/item_modifiers/item_modifier[@name='remsRodModWireLeader']/property[@name='CustomIconTint']" />
	<set xpath="/item_modifiers/item_modifier[@name='remsRodModCorkGrip']/property[@name='CustomIcon']/@value">remsRodModCorkGrip</set>
	<remove xpath="/item_modifiers/item_modifier[@name='remsRodModCorkGrip']/property[@name='CustomIconTint']" />
	<set xpath="/item_modifiers/item_modifier[@name='remsRodModSlipFloat']/property[@name='CustomIcon']/@value">remsRodModSlipFloat</set>
	<remove xpath="/item_modifiers/item_modifier[@name='remsRodModSlipFloat']/property[@name='CustomIconTint']" />
	<set xpath="/item_modifiers/item_modifier[@name='remsRodModBottomSinker']/property[@name='CustomIcon']/@value">remsRodModBottomSinker</set>
	<set xpath="/item_modifiers/item_modifier[@name='remsRodModBiteBell']/property[@name='CustomIcon']/@value">remsRodModBiteBell</set>
	<remove xpath="/item_modifiers/item_modifier[@name='remsRodModBiteBell']/property[@name='CustomIconTint']" />
	<!-- icons:end -->
</configs>
