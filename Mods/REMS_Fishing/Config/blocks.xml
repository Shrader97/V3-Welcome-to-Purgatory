<configs>
	<!-- earthworms turn up when you dig soil: about 1 block in 20 -->
	<append xpath="/blocks/block[@name='terrDirt' or @name='terrForestGround' or @name='terrBurntForestGround' or @name='terrGrass']">
		<drop event="Harvest" name="remsBaitEarthworms" count="1" prob="0.05" tag="oreWoodHarvest"/>
	</append>
	<!-- the universal Fishing Trap (spec 5): a wire cage you set in water at least one block deep. Bait goes in slot 1.
	     REMS.Fishing rolls a catch chance every 4 in-game hours on the server; zombies can break it like any other block. -->
	<append xpath="/blocks">
		<block name="remsFishingTrap">
			<property name="CreativeMode" value="Player" />
			<property name="Class" value="REMSFishingTrap, REMS.Fishing" />
			<property class="CompositeFeatures">
				<property class="TEFeatureStorage">
					<property name="LootList" value="remsFishingTrap" />
				</property>
				<property class="TEFeatureLockable" />
			</property>
			<property name="DescriptionKey" value="remsFishingTrapDesc" />
			<property name="Material" value="Mmetal" />
			<property name="Shape" value="ModelEntity" />
			<property name="Model" value="#@modfolder:Resources/REMSFishing.unity3d?trap_cage" />
			<property name="WaterFlow" value="permitted" />
			<property name="Path" value="solid" />
			<property name="Place" value="TowardsPlacerInverted" />
			<property name="AllowedRotations" value="Basic90" />
			<property name="EconomicValue" value="120" />
			<property name="MaxDamage" value="400" />
			<property name="SoundPickup" value="crateiron_grab" />
			<property name="SoundPlace" value="crateiron_place" />
			<property name="CustomIcon" value="remsFishingTrap" />
			<property class="RepairItems">
				<property name="resourceScrapIron" value="4" />
			</property>
			<drop event="Destroy" name="resourceScrapIron" count="3,8" />
			<drop event="Fall" name="scrapMetalPile" count="1" prob="0.5" stick_chance="1" />
			<property name="CanPickup" value="true" />
			<property name="TakeDelay" value="2" />
			<property name="Group" value="Basics,Building,advBuilding" />
			<property name="FilterTags" value="MC_playerBlocks,SC_decor" />
			<property name="SortOrder1" value="B108" />
			<property name="SortOrder2" value="0001" />
		</block>
	</append>

