	<!-- wip-ponds:begin (generated by Tools/merge_wip.py (ponds)) -->
	<!-- Pond Marker (spec 7.2): place it at the edge of built water with a 7 x 7 patch at least 3 deep and REMS.Fishing
	     registers the pond on the server (REMS_FishingPonds.txt next to the save). Looking at it shows the pond's state;
	     E with a jar of fingerlings releases them. Picking it up (2 s, from the hold-E menu) or breaking it ends the
	     pond and its stock. Vanilla land claims decide who can place, pick up and stock it. Model: the vanilla 1 x 1
	     wooden sign (placeholder until a stake model exists). -->
	<append xpath="/blocks">
		<block name="remsPondMarker">
			<property name="CreativeMode" value="Player"/>
			<property name="Class" value="REMSPondMarker, REMS.Fishing"/>
			<property name="Tags" value="remsPondMarker"/>
			<property name="DescriptionKey" value="remsPondMarkerDesc"/>
			<property name="Material" value="Mwood_regular"/>
			<property name="Shape" value="ModelEntity"/>
			<property name="Model" value="@:Entities/Crafting/sign_wood_1x1_Prefab.prefab"/>
			<property name="WaterFlow" value="permitted"/>
			<property name="Place" value="TowardsPlacerInverted"/>
			<property name="HandleFace" value="South"/>
			<property name="Collide" value="movement,melee,bullet,arrow,rocket"/>
			<property name="StabilitySupport" value="false"/>
			<property name="MaxDamage" value="500"/>
			<property name="CanPickup" value="true"/>
			<!-- priced near its inputs (10 wood, 4 nails, 2 paint) and, like vanilla's utility blocks, not sold back -->
			<property name="EconomicValue" value="30"/>
			<property name="SellableToTrader" value="false"/>
			<!-- the crafting window says "Unlocked by: Fishing" (the skill module unlocks the recipe at Fishing 31) -->
			<property name="UnlockedBy" value="craftingFishing"/>
			<property name="CustomIcon" value="remsPondMarker"/>
			<property class="RepairItems">
				<property name="resourceWood" value="2"/>
			</property>
			<drop event="Harvest" name="resourceWood" count="2" tag="allHarvest"/>
			<drop event="Destroy" name="resourceWood" count="1,3"/>
			<drop event="Fall" count="0" prob="0"/>
			<property name="Group" value="Basics,Building"/>
			<property name="FilterTags" value="MC_playerBlocks,SC_decor"/>
			<property name="SortOrder1" value="B108"/>
			<property name="SortOrder2" value="0002"/>
		</block>
	</append>
	<!-- wip-ponds:end -->
	<!-- wip-skill:begin (generated by Tools/merge_wip.py (skill)) -->
	<!-- The Fishing Trap unlocks at Fishing 6: shows "Unlocked by: Fishing" in the crafting window (Block.UnlockedBy).
	     The Pond Marker belongs to the ponds module, which should add the same property to remsPondMarker. -->
	<append xpath="/blocks/block[@name='remsFishingTrap']">
		<property name="UnlockedBy" value="craftingFishing"/>
	</append>
	<!-- wip-skill:end -->
	<!-- wip-traders:begin (generated by Tools/merge_wip.py (traders)) -->
	<!-- Fishing Trap: 15 scrap iron + 4 wood + 1 duct tape = 42 EV of workbench materials (30 s). At EV 120 a crafted
	     trap sold for 24 dukes against 8.4 dukes of materials (x2.86). The audit's cap for crafted fishing gear is about
	     1.5x (vanilla steel tools 1.41): a 0.5 sale scale (Block.EconomicSellScale, applied in XUiM_Trader.GetSellPrice)
	     makes it 12 dukes (x1.43). EV 120 stays as the trader price (360 dukes), the alternative to crafting (spec 5). -->
	<append xpath="/blocks/block[@name='remsFishingTrap']">
		<property name="EconomicSellScale" value="0.5"/>
	</append>
	<!-- wip-traders:end -->
</configs>
