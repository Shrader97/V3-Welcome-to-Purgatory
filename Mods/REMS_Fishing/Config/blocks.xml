		<!-- Frogs drop nothing when hit, shot, blown up or undermined: a hit or shot makes the frog jump into the water
		     (BlockREMSFrogSpot.OnBlockDamaged), so the server's capture roll (E) is the only way to get one (spec 6.2). -->
		<block name="remsFrogBull">
			<property name="CreativeMode" value="Dev" />
			<property name="Class" value="REMSFrogSpot, REMS.Fishing" />
			<property name="DescriptionKey" value="remsCatchBullfrogDesc" />
			<property name="Material" value="Morganic" />
			<property name="Shape" value="ModelEntity" />
			<property name="Model" value="#@modfolder:Resources/REMSFishing.unity3d?frog_bull" />
