<configs>
	<!-- wip-jobs:begin (generated by Tools/merge_wip.py (jobs)) -->
	<!-- Marked water job: map, compass and on-screen marker for the lake (registered on the client by JobsClient while
	     the job is held and not yet done). Sprite rems_fishing_jobs ships in UIAtlases/UIAtlas. -->
	<append xpath="/nav_object_classes">
		<nav_object_class name="remsFishingJob">
			<map_settings>
				<property name="sprite_name" value="rems_fishing_jobs"/>
				<property name="min_distance" value="0"/>
				<property name="max_distance" value="-1"/>
				<property name="color" value="90,180,235,255"/>
				<property name="has_pulse" value="true"/>
			</map_settings>

			<compass_settings>
				<property name="sprite_name" value="rems_fishing_jobs"/>
				<property name="min_distance" value="0"/>
				<property name="max_scale_distance" value="1024"/>
				<property name="color" value="90,180,235,255"/>
				<property name="has_pulse" value="false"/>
				<property name="icon_clamped" value="true" />
			</compass_settings>

			<onscreen_settings>
				<property name="sprite_name" value="rems_fishing_jobs"/>
				<property name="min_distance" value="0"/>
				<property name="max_distance" value="250"/>
				<property name="color" value="90,180,235,255"/>
				<property name="has_pulse" value="false"/>
				<property name="text_type" value="Distance"/>
				<property name="show_offscreen" value="false" />
			</onscreen_settings>
		</nav_object_class>
	</append>
	<!-- wip-jobs:end -->
</configs>
