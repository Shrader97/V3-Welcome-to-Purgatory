<configs>
	<!-- wip-traders:begin (generated by Tools/merge_wip.py (traders)) -->
	<!-- REMS Fishing trader stock (spec 8.3, design 11). Traders sell the tackle; they buy catches through each item's
	     EconomicValue (sell = value x 0.2, vanilla sell_markdown), so buying needs no trader patch.
	     How the engine reads this (decompiled V3.4 TradersFromXml / TraderInfo / XUiC_TraderWindow):
	       - a trader_item_group must be defined before anything references it (parseItemList throws otherwise);
	       - count="all" spawns every entry; a group without count makes one weighted pick (prob) per roll;
	       - an item's TraderStageTemplate hides it in the trader window until the trader stage (player level x
	         1.0-1.3 by the quest tier reached with that trader, EntityPlayer.GetTraderStage) is inside an entry for
	         its quality (0 for items without quality).
	     Trader stage follows the player's level, not the Fishing skill, so the templates below use the Fishing level
	     that unlocks the same thing for crafting as the stage it appears from (vanilla does the same: iron tools from
	     stage 15, steel from 50). -->

	<append xpath="/traders/traderstage_templates">
		<!-- Standard Fishing Rod: Q1 always (spec: "Standard 120 at Q1" in every trader); each higher quality appears at
		     the Fishing level that crafts it (4/8/12/16/20) -->
		<traderstage_template name="remsFishingRodStandard">
			<entry min="1" max="999999" quality="0"/>
			<entry min="1" max="999999" quality="1"/>
			<entry min="4" max="999999" quality="2"/>
			<entry min="8" max="999999" quality="3"/>
			<entry min="12" max="999999" quality="4"/>
			<entry min="16" max="999999" quality="5"/>
			<entry min="20" max="999999" quality="6"/>
		</traderstage_template>
		<!-- Precision Fishing Rod: Q1 from trader stage 30, then 34/38/42/46/50 (the Fishing levels that craft each
		     quality). The spec's "from trader stage 3" cannot be literal (stage 3 is a level-3 player), and V3.4 never
		     spawns trader_info tier_items, so stock cannot be gated on the quest tier itself: stage 30 is the
		     Fishing-30 band. Change the min values here if another band is wanted. -->
		<traderstage_template name="remsFishingRodPrecision">
			<entry min="30" max="999999" quality="0"/>
			<entry min="30" max="999999" quality="1"/>
			<entry min="34" max="999999" quality="2"/>
			<entry min="38" max="999999" quality="3"/>
			<entry min="42" max="999999" quality="4"/>
			<entry min="46" max="999999" quality="5"/>
			<entry min="50" max="999999" quality="6"/>
		</traderstage_template>
		<!-- tackle, glow bait and fingerlings by unlock band (Fishing 10+/20+/30+/40+); every quality is listed so the
		     templates work for items with or without quality -->
		<traderstage_template name="remsFishingStage10">
			<entry min="10" max="999999" quality="0"/>
			<entry min="10" max="999999" quality="1"/>
			<entry min="10" max="999999" quality="2"/>
			<entry min="10" max="999999" quality="3"/>
			<entry min="10" max="999999" quality="4"/>
			<entry min="10" max="999999" quality="5"/>
			<entry min="10" max="999999" quality="6"/>
		</traderstage_template>
		<traderstage_template name="remsFishingStage20">
			<entry min="20" max="999999" quality="0"/>
			<entry min="20" max="999999" quality="1"/>
			<entry min="20" max="999999" quality="2"/>
			<entry min="20" max="999999" quality="3"/>
			<entry min="20" max="999999" quality="4"/>
			<entry min="20" max="999999" quality="5"/>
			<entry min="20" max="999999" quality="6"/>
		</traderstage_template>
		<traderstage_template name="remsFishingStage30">
			<entry min="30" max="999999" quality="0"/>
			<entry min="30" max="999999" quality="1"/>
			<entry min="30" max="999999" quality="2"/>
			<entry min="30" max="999999" quality="3"/>
			<entry min="30" max="999999" quality="4"/>
			<entry min="30" max="999999" quality="5"/>
			<entry min="30" max="999999" quality="6"/>
		</traderstage_template>
		<traderstage_template name="remsFishingStage40">
			<entry min="40" max="999999" quality="0"/>
			<entry min="40" max="999999" quality="1"/>
			<entry min="40" max="999999" quality="2"/>
			<entry min="40" max="999999" quality="3"/>
			<entry min="40" max="999999" quality="4"/>
			<entry min="40" max="999999" quality="5"/>
			<entry min="40" max="999999" quality="6"/>
		</traderstage_template>
	</append>

	<!-- Groups are appended after the vanilla groups: only trader_info (later in the file) references them. -->
	<append xpath="/traders/trader_item_groups">
		<!-- one extra rod per restock: usually a better Standard rod, sometimes a Precision rod (hidden below stage 30) -->
		<trader_item_group name="remsFishingRodRoll">
			<item name="remsFishingRodStandard" quality="2,6" prob="3"/>
			<item name="remsFishingRodPrecision" quality="1,6" prob="1"/>
		</trader_item_group>

		<!-- lures and rod mods (tool section); higher pieces stay hidden until the trader stage reaches their band -->
		<trader_item_group name="remsFishingTackle">
			<item name="remsLureSpinner" prob="3"/>
			<item name="remsLureJig" prob="3"/>
			<item name="remsLureCrankbait" prob="2"/>
			<item name="remsLureTroutFly" prob="2"/>
			<item name="remsRodModCorkGrip" prob="2"/>
			<item name="remsRodModSlipFloat" prob="2"/>
			<item name="remsRodModSmoothDrag" prob="1.5"/>
			<item name="remsRodModBottomSinker" prob="1.5"/>
			<item name="remsRodModBraidedLine" prob="1"/>
			<item name="remsRodModWireLeader" prob="1"/>
			<item name="remsRodModFluorocarbon" prob="1"/>
			<item name="remsRodModBiteBell" prob="0.75"/>
			<item name="remsTrapModFunnel" prob="1.5"/>
			<item name="remsTrapModBaitBox" prob="1"/>
			<item name="remsTrapModBigCage" prob="0.75"/>
		</trader_item_group>

		<!-- bait beyond the earthworms every trader keeps -->
		<trader_item_group name="remsFishingBaitRoll">
			<item name="remsBaitCut" count="5,20" prob="3"/>
			<item name="remsBaitDough" count="5,20" prob="3"/>
			<item name="remsBaitGlow" count="3,9" prob="1"/>
		</trader_item_group>

		<!-- Angler's Monthly beside the skill magazines. Every vanilla trader rolls skillMagazines unique_only count 7
		     out of 24 titles (29% per title per restock, 1-3 copies). A pick of 7 in 24 here gives Angler's Monthly the
		     same odds without adding it to the vanilla group, which would thin every vanilla title (7/25 each). A trader
		     roll cannot come up empty (TraderInfo.SpawnAllItemsFromList spawns at least 1), so the other picks are
		     extra earthworms. -->
		<trader_item_group name="remsFishingMagazineRoll">
			<item name="remsAnglersMonthly" count="1,3" prob="7"/>
			<item name="remsBaitEarthworms" count="5,15" prob="17"/>
		</trader_item_group>

		<!-- The Patient Angler, rare. A vanilla restock shows about 2.1 of the 133 perk-book volumes (the books group:
		     perkBooks once plus commonBooks' 60% perk share, plus traderGeneral), 1.6% per volume; 7 picks in 63 here gives
		     each of the seven volumes the same 1.6% (11% that a trader has one). The other picks are cut bait. -->
		<trader_item_group name="remsFishingBookRoll">
			<item name="remsBookPatientAngler1" prob="1"/>
			<item name="remsBookPatientAngler2" prob="1"/>
			<item name="remsBookPatientAngler3" prob="1"/>
			<item name="remsBookPatientAngler4" prob="1"/>
			<item name="remsBookPatientAngler5" prob="1"/>
			<item name="remsBookPatientAngler6" prob="1"/>
			<item name="remsBookPatientAngler7" prob="1"/>
			<item name="remsBaitCut" count="5,10" prob="56"/>
		</trader_item_group>

		<!-- fingerlings for stocked ponds (spec 7.2): common and uncommon species. Rare species come from Angler standing
		     3 and the mutant carp from standing 4 (the jobs board's own stock), never from the open shelf. -->
		<trader_item_group name="remsFishingFingerlings">
			<item name="remsFingerlingBluegill" count="1,3" prob="2"/>
			<item name="remsFingerlingPerch" count="1,3" prob="2"/>
			<item name="remsFingerlingCarp" count="1,3" prob="2"/>
			<item name="remsFingerlingBass" count="1,2" prob="1"/>
			<item name="remsFingerlingTrout" count="1,2" prob="1"/>
			<item name="remsFingerlingCatfish" count="1,2" prob="1"/>
			<item name="remsFingerlingEel" count="1,2" prob="1"/>
		</trader_item_group>

		<!-- everything one trader carries for anglers, per restock -->
		<trader_item_group name="remsFishingStock" count="all">
			<!-- tool section -->
			<item name="remsFishingRodStandard" quality="1"/>
			<item group="remsFishingRodRoll"/>
			<item group="remsFishingTackle" unique_only="true" count="2,4"/>
			<item name="remsFishingTrap" count="1,2"/>
			<item name="remsDipNet"/>
			<!-- general stock -->
			<item name="remsBaitEarthworms" count="10,30"/>
			<item group="remsFishingBaitRoll" unique_only="true" count="1,2"/>
			<item group="remsFishingFingerlings" unique_only="true" count="2,3"/>
			<!-- reading -->
			<item group="remsFishingMagazineRoll"/>
			<item group="remsFishingBookRoll"/>
		</trader_item_group>
	</append>

	<!-- Every trader with stock gets the fishing stock in its specialty list: Joel, Bob, Jen, Hugh, Rekt, the play-test
	     trader, and traders other mods add before this one loads. Vending machines (is_vending) and player-owned or
	     rented machines (no trader_items) are left alone. The trader window sorts items into its tabs by each item's
	     Group (rods, lures, trap and net: Tools/Traps; mods: Mods), so "tool section" needs no extra list. -->
	<append xpath="/traders/trader_info[trader_items and not(@is_vending='true')]/trader_items[1]">
		<item group="remsFishingStock"/>
	</append>
	<!-- wip-traders:end -->
</configs>
