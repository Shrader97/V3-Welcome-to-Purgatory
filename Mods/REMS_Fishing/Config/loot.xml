<configs>
	<!-- strongbox loot groups go before vanilla's first group: a group must be defined before anything rolls it -->
	<insertBefore xpath="/lootcontainers/lootgroup[1]">
		<lootgroup name="remsStrongboxValuables">
			<item name="resourceSilverNugget" count="1,2"/>
			<item name="resourceGoldNugget" count="1"/>
			<item name="resourceScrapBrass" count="6,12"/>
			<item name="resourceRepairKit" count="1"/>
			<item name="remsLureSpinner" count="1"/>
			<item name="remsAnglersMonthly" count="1"/>
		</lootgroup>
	</insertBefore>

	<append xpath="/lootcontainers">
		<!-- the Fishing Trap's cage: slot 1 is bait, the rest hold up to six catches. REMS.Fishing fills it; nothing spawns in it. -->
		<lootcontainer name="remsFishingTrap" count="0" size="7,2" sound_open="UseActions/crate_iron_open" sound_close="UseActions/crate_iron_close" loot_quality_template="qualBaseTemplate">
			<item name="cobweb" count="0"/>
		</lootcontainer>

		<!-- Waterlogged Strongbox (spec 12): bounded dukes, salvage valuables, tackle or a magazine, opened in the backpack.
		     remsStrongboxValuables (above) holds the finds, Angler's Monthly among them. The vanilla magazine chance rolls
		     here, not in that group: it names vanilla's skillMagazines, which is defined after the inserted group
		     (lootgroups must be defined before anything rolls them), and these containers are appended after it.
		     Only a lootgroup takes count="all" (a lootcontainer's count must be a number, or ALL of loot.xml fails to
		     load), so each box rolls its one "all" group once. In that group every entry spawns; a force_prob entry
		     spawns only when its own prob roll passes (LootContainer.SpawnAllItemsFromList). -->
		<lootgroup name="remsStrongboxModestAll" count="all">
			<item name="casinoCoin" count="30,150"/>
			<item group="remsStrongboxValuables" count="1"/>
			<item group="skillMagazines" count="1" prob="0.15" force_prob="true"/>
		</lootgroup>
		<lootgroup name="remsStrongboxStandardAll" count="all">
			<item name="casinoCoin" count="80,300"/>
			<item group="remsStrongboxValuables" count="2"/>
			<item group="skillMagazines" count="1" prob="0.25" force_prob="true"/>
		</lootgroup>
		<lootcontainer name="remsStrongboxModest" count="1" size="6,1" sound_open="UseActions/open_safe" sound_close="UseActions/close_safe" loot_quality_template="qualBaseTemplate" destroy_on_close="empty">
			<item group="remsStrongboxModestAll"/>
		</lootcontainer>
		<lootcontainer name="remsStrongboxStandard" count="1" size="6,1" sound_open="UseActions/open_safe" sound_close="UseActions/close_safe" loot_quality_template="qualBaseTemplate" destroy_on_close="empty">
			<item group="remsStrongboxStandardAll"/>
		</lootcontainer>
	</append>
