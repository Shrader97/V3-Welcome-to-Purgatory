<configs>
	<!-- cooking:begin (generated by Tools/meals.py) -->
	<append xpath="//crafting_skill[@name='craftingFood']/effect_group[1]">
		<passive_effect name="RecipeTagUnlocked" operation="base_set" level="6,100" value="1" tags="remsFishingMealGrilledFish"/>
		<passive_effect name="RecipeTagUnlocked" operation="base_set" level="8,100" value="1" tags="remsFishingMealBoiledShellfish"/>
		<passive_effect name="RecipeTagUnlocked" operation="base_set" level="8,100" value="1" tags="remsFishingMealSteamedClams"/>
		<passive_effect name="RecipeTagUnlocked" operation="base_set" level="14,100" value="1" tags="remsFishingMealFriedFrogLegs"/>
		<passive_effect name="RecipeTagUnlocked" operation="base_set" level="22,100" value="1" tags="remsFishingMealTurtleSoup"/>
		<passive_effect name="RecipeTagUnlocked" operation="base_set" level="22,100" value="1" tags="remsFishingMealFishStew"/>
		<passive_effect name="RecipeTagUnlocked" operation="base_set" level="26,100" value="1" tags="remsFishingMealClamChowder"/>
		<passive_effect name="RecipeTagUnlocked" operation="base_set" level="27,100" value="1" tags="remsFishingMealCrawfishBoil"/>
	</append>
	<append xpath="//crafting_skill[@name='craftingFood']/display_entry[1]">
		<unlock_entry item="remsFishingMealGrilledFish" unlock_tier="3"/>
	</append>
	<append xpath="//crafting_skill[@name='craftingFood']/display_entry[1]">
		<unlock_entry item="remsFishingMealBoiledShellfish" unlock_tier="4"/>
	</append>
	<append xpath="//crafting_skill[@name='craftingFood']/display_entry[1]">
		<unlock_entry item="remsFishingMealSteamedClams" unlock_tier="4"/>
	</append>
	<append xpath="//crafting_skill[@name='craftingFood']/display_entry[2]">
		<unlock_entry item="remsFishingMealFriedFrogLegs" unlock_tier="2"/>
	</append>
	<append xpath="//crafting_skill[@name='craftingFood']/display_entry[2]">
		<unlock_entry item="remsFishingMealTurtleSoup" unlock_tier="4"/>
	</append>
	<append xpath="//crafting_skill[@name='craftingFood']/display_entry[2]">
		<unlock_entry item="remsFishingMealFishStew" unlock_tier="4"/>
	</append>
	<append xpath="//crafting_skill[@name='craftingFood']/display_entry[2]">
		<unlock_entry item="remsFishingMealClamChowder" unlock_tier="5"/>
	</append>
	<append xpath="//crafting_skill[@name='craftingFood']/display_entry[3]">
		<unlock_entry item="remsFishingMealCrawfishBoil" unlock_tier="1"/>
	</append>
	<conditional>
		<if cond="mod_loaded('REMS_CulinaryHearth')">
		</if>
		<else>
			<append xpath="//crafting_skill[@name='craftingFood']/effect_group[1]">
				<passive_effect name="RecipeTagUnlocked" operation="base_set" level="35,100" value="1" tags="remsFishingMealFishAndChips"/>
			</append>
			<append xpath="//crafting_skill[@name='craftingFood']/display_entry[3]">
				<unlock_entry item="remsFishingMealFishAndChips" unlock_tier="2"/>
			</append>
		</else>
	</conditional>
	<!-- cooking:end -->
	<!-- wip-skill:begin (generated by Tools/merge_wip.py (skill)) -->
	<!-- ===================================================================================================== -->
	<!-- REMS Fishing: the Fishing crafting skill, raised by Angler's Monthly (spec 9.1, 9.2, 2.7)              -->
	<!-- Modelled on vanilla crafting skills (craftingHarvestingTools, craftingExplosives, craftingFood).       -->
	<!-- The skill window shows five rows (XUiC_SkillCraftingInfoWindow: 5 entries, paging is off), so the     -->
	<!-- unlocks are grouped: Standard rod quality, bait and gear, rod mods, lures, Precision rod quality.      -->
	<!-- A row's name and icon are those of its next unlock (ProgressionClass.DisplayData.GetName/GetIcon).    -->
	<!-- Row icons are the same sprites the items use today (placeholders: see REPORT.md).                     -->
	<!-- ===================================================================================================== -->
	<insertAfter xpath="/progression/crafting_skills/crafting_skill[@name='craftingFood']">
		<crafting_skill name="craftingFishing" max_level="50" parent="attCrafting" name_key="craftingFishingName" desc_key="craftingFishingDesc" long_desc_key="craftingFishingLongDesc" icon="ui_game_symbol_rems_fishing">

			<!-- Standard Fishing Rod: known from the start (Q1), quality 2-6 at Fishing 4, 8, 12, 16, 20 -->
			<display_entry item="remsFishingRodStandard" unlock_level="1,4,8,12,16,20"/>

			<!-- Bait and gear: cut bait 3, Dip Net 4, dough bait 5, Fishing Trap 6, glow bait 25, Pond Marker 31 -->
			<display_entry icon="foodRawMeat,remsDipNet,foodCornMeal,remsFishingTrap,foodRottingFlesh,remsPondMarker" name_key="remsBaitCut,remsDipNet,remsBaitDough,remsFishingTrap,remsBaitGlow,remsPondMarker" has_quality="false" unlock_level="3,4,5,6,25,31">
				<unlock_entry item="remsBaitCut" unlock_tier="1"/>
				<unlock_entry item="remsDipNet" unlock_tier="2"/>
				<unlock_entry item="remsBaitDough" unlock_tier="3"/>
				<unlock_entry item="remsFishingTrap" unlock_tier="4"/>
				<unlock_entry item="remsBaitGlow" unlock_tier="5"/>
				<unlock_entry item="remsPondMarker" unlock_tier="6"/>
			</display_entry>

			<!-- Rod mods: Cork Grip 8, Slip Float 12, Smooth Drag 14, Bottom Sinker 18, Braided Line 24, Wire Leader 28,
			     Fluorocarbon 33, Bite Bell 40 -->
			<display_entry icon="modMeleeErgonomicGrip,lightCeilingBulbSocketWhite,resourceElectricParts,resourceFishingWeight,modGunBowPolymerString,modGunBowPolymerString,modGunBowPolymerString,churchBell" name_key="remsRodModCorkGrip,remsRodModSlipFloat,remsRodModSmoothDrag,remsRodModBottomSinker,remsRodModBraidedLine,remsRodModWireLeader,remsRodModFluorocarbon,remsRodModBiteBell" has_quality="false" unlock_level="8,12,14,18,24,28,33,40">
				<unlock_entry item="remsRodModCorkGrip" unlock_tier="1"/>
				<unlock_entry item="remsRodModSlipFloat" unlock_tier="2"/>
				<unlock_entry item="remsRodModSmoothDrag" unlock_tier="3"/>
				<unlock_entry item="remsRodModBottomSinker" unlock_tier="4"/>
				<unlock_entry item="remsRodModBraidedLine" unlock_tier="5"/>
				<unlock_entry item="remsRodModWireLeader" unlock_tier="6"/>
				<unlock_entry item="remsRodModFluorocarbon" unlock_tier="7"/>
				<unlock_entry item="remsRodModBiteBell" unlock_tier="8"/>
			</display_entry>

			<!-- Trap mods: Funnel Entrance 10, Bait Box 20, Bigger Cage 30 -->
			<display_entry icon="remsTrapModFunnel,remsTrapModBaitBox,remsTrapModBigCage" name_key="remsTrapModFunnel,remsTrapModBaitBox,remsTrapModBigCage" has_quality="false" unlock_level="10,20,30">
				<unlock_entry item="remsTrapModFunnel" unlock_tier="1"/>
				<unlock_entry item="remsTrapModBaitBox" unlock_tier="2"/>
				<unlock_entry item="remsTrapModBigCage" unlock_tier="3"/>
			</display_entry>

			<!-- Lures: spinner 11, jig 18, crankbait 24, trout fly 34 -->
			<display_entry icon="resourceBulletTip,resourceFishingWeight,resourceArrowHeadIron,resourceFeather" name_key="remsLureSpinner,remsLureJig,remsLureCrankbait,remsLureTroutFly" has_quality="false" unlock_level="11,18,24,34">
				<unlock_entry item="remsLureSpinner" unlock_tier="1"/>
				<unlock_entry item="remsLureJig" unlock_tier="2"/>
				<unlock_entry item="remsLureCrankbait" unlock_tier="3"/>
				<unlock_entry item="remsLureTroutFly" unlock_tier="4"/>
			</display_entry>

			<!-- Precision Fishing Rod: Q1 at Fishing 30, quality 2-6 at 34, 38, 42, 46, 50 -->
			<display_entry item="remsFishingRodPrecision" unlock_level="30,34,38,42,46,50"/>

			<effect_group>
				<!-- recipes: a recipe tagged "learnable" is craftable when RecipeTagUnlocked > 0 for its own name tag -->
				<passive_effect name="RecipeTagUnlocked" operation="base_set" level="1,50" value="1" tags="remsFishingRodStandard"/>
				<passive_effect name="RecipeTagUnlocked" operation="base_set" level="3,50" value="1" tags="remsBaitCut"/>
				<passive_effect name="RecipeTagUnlocked" operation="base_set" level="4,50" value="1" tags="remsDipNet"/>
				<passive_effect name="RecipeTagUnlocked" operation="base_set" level="5,50" value="1" tags="remsBaitDough"/>
				<passive_effect name="RecipeTagUnlocked" operation="base_set" level="6,50" value="1" tags="remsFishingTrap"/>
				<passive_effect name="RecipeTagUnlocked" operation="base_set" level="8,50" value="1" tags="remsRodModCorkGrip"/>
				<passive_effect name="RecipeTagUnlocked" operation="base_set" level="10,50" value="1" tags="remsTrapModFunnel"/>
				<passive_effect name="RecipeTagUnlocked" operation="base_set" level="20,50" value="1" tags="remsTrapModBaitBox"/>
				<passive_effect name="RecipeTagUnlocked" operation="base_set" level="30,50" value="1" tags="remsTrapModBigCage"/>
				<passive_effect name="RecipeTagUnlocked" operation="base_set" level="11,50" value="1" tags="remsLureSpinner"/>
				<passive_effect name="RecipeTagUnlocked" operation="base_set" level="12,50" value="1" tags="remsRodModSlipFloat"/>
				<passive_effect name="RecipeTagUnlocked" operation="base_set" level="14,50" value="1" tags="remsRodModSmoothDrag"/>
				<passive_effect name="RecipeTagUnlocked" operation="base_set" level="18,50" value="1" tags="remsLureJig,remsRodModBottomSinker"/>
				<passive_effect name="RecipeTagUnlocked" operation="base_set" level="24,50" value="1" tags="remsLureCrankbait,remsRodModBraidedLine"/>
				<passive_effect name="RecipeTagUnlocked" operation="base_set" level="25,50" value="1" tags="remsBaitGlow"/>
				<passive_effect name="RecipeTagUnlocked" operation="base_set" level="28,50" value="1" tags="remsRodModWireLeader"/>
				<passive_effect name="RecipeTagUnlocked" operation="base_set" level="30,50" value="1" tags="remsFishingRodPrecision"/>
				<passive_effect name="RecipeTagUnlocked" operation="base_set" level="31,50" value="1" tags="remsPondMarker"/>
				<passive_effect name="RecipeTagUnlocked" operation="base_set" level="33,50" value="1" tags="remsRodModFluorocarbon"/>
				<passive_effect name="RecipeTagUnlocked" operation="base_set" level="34,50" value="1" tags="remsLureTroutFly"/>
				<passive_effect name="RecipeTagUnlocked" operation="base_set" level="40,50" value="1" tags="remsRodModBiteBell"/>

				<!-- crafted quality: base 1, +1 per step. PassiveEffect.ModValue lerps between listed levels and
				     Recipe.GetCraftingTier truncates to int, so each quality arrives exactly at its level -->
				<passive_effect name="CraftingTier" operation="base_add" level="4,8,12,16,20,50" value="1,2,3,4,5,5" tags="remsFishingRodStandard"/>
				<passive_effect name="CraftingTier" operation="base_add" level="34,38,42,46,50" value="1,2,3,4,5" tags="remsFishingRodPrecision"/>
			</effect_group>
		</crafting_skill>
	</insertAfter>

	<!-- ===================================================================================================== -->
	<!-- The Patient Angler (spec 9.3): a vanilla book series. The group sits under attBooks, so the skills    -->
	<!-- screen lists it with the other books; its volumes are <book> perks in the order the window shows them  -->
	<!-- (XUiC_SkillBookInfoWindow: the last child is the collector's reward). The bonuses live in the DLL      -->
	<!-- (FishingProgression.RemsFishingInit sets FishingPerks), which reads these progression levels.         -->
	<!-- ===================================================================================================== -->
	<append xpath="/progression/skills">
		<book_group name="skillRemsPatientAngler" parent="attBooks" name_key="remsPatientAngler0Name" desc_key="remsPatientAngler0Desc" long_desc_key="perkBookGroupLongDesc" icon="ui_game_symbol_rems_hook"><effect_group/></book_group>
	</append>

	<append xpath="/progression/perks">
		<!-- *** THE_PATIENT_ANGLER_VOLUME_01_READING_THE_WATER -->
		<book name="perkRemsPatientAngler1ReadingTheWater" parent="skillRemsPatientAngler" max_level="1" base_skill_point_cost="0" name_key="perkRemsPatientAngler1ReadingTheWaterName" desc_key="perkRemsPatientAngler1ReadingTheWaterDesc" long_desc_key="perkRemsPatientAngler1ReadingTheWaterLongDesc">
			<effect_group><!-- effect is in REMS.Fishing: FishingPerks.ShowsWaterSpecies --></effect_group>
		</book>
		<!-- *** THE_PATIENT_ANGLER_VOLUME_02_QUICK_HANDS -->
		<book name="perkRemsPatientAngler2QuickHands" parent="skillRemsPatientAngler" max_level="1" base_skill_point_cost="0" name_key="perkRemsPatientAngler2QuickHandsName" desc_key="perkRemsPatientAngler2QuickHandsDesc" long_desc_key="perkRemsPatientAngler2QuickHandsLongDesc">
			<effect_group><!-- effect is in REMS.Fishing: FishingPerks.BiteWindowBonus --></effect_group>
		</book>
		<!-- *** THE_PATIENT_ANGLER_VOLUME_03_STRONG_WRISTS -->
		<book name="perkRemsPatientAngler3StrongWrists" parent="skillRemsPatientAngler" max_level="1" base_skill_point_cost="0" name_key="perkRemsPatientAngler3StrongWristsName" desc_key="perkRemsPatientAngler3StrongWristsDesc" long_desc_key="perkRemsPatientAngler3StrongWristsLongDesc">
			<effect_group><!-- effect is in REMS.Fishing: FishingPerks.ReelStaminaFactor --></effect_group>
		</book>
		<!-- *** THE_PATIENT_ANGLER_VOLUME_04_FEELING_THE_LINE -->
		<book name="perkRemsPatientAngler4FeelingTheLine" parent="skillRemsPatientAngler" max_level="1" base_skill_point_cost="0" name_key="perkRemsPatientAngler4FeelingTheLineName" desc_key="perkRemsPatientAngler4FeelingTheLineDesc" long_desc_key="perkRemsPatientAngler4FeelingTheLineLongDesc">
			<effect_group><!-- effect is in REMS.Fishing: FishingPerks.SnapExtraSeconds --></effect_group>
		</book>
		<!-- *** THE_PATIENT_ANGLER_VOLUME_05_BAIT_AND_SWITCH -->
		<book name="perkRemsPatientAngler5BaitAndSwitch" parent="skillRemsPatientAngler" max_level="1" base_skill_point_cost="0" name_key="perkRemsPatientAngler5BaitAndSwitchName" desc_key="perkRemsPatientAngler5BaitAndSwitchDesc" long_desc_key="perkRemsPatientAngler5BaitAndSwitchLongDesc">
			<effect_group><!-- effect is in REMS.Fishing: FishingPerks.KeepBaitChance --></effect_group>
		</book>
		<!-- *** THE_PATIENT_ANGLER_VOLUME_06_CLEAN_CUTS -->
		<book name="perkRemsPatientAngler6CleanCuts" parent="skillRemsPatientAngler" max_level="1" base_skill_point_cost="0" name_key="perkRemsPatientAngler6CleanCutsName" desc_key="perkRemsPatientAngler6CleanCutsDesc" long_desc_key="perkRemsPatientAngler6CleanCutsLongDesc">
			<effect_group><!-- effect is in REMS.Fishing: FishingPerks.ExtraYield --></effect_group>
		</book>
		<!-- *** THE_PATIENT_ANGLER_VOLUME_07_AFTER_DARK -->
		<book name="perkRemsPatientAngler7AfterDark" parent="skillRemsPatientAngler" max_level="1" base_skill_point_cost="0" name_key="perkRemsPatientAngler7AfterDarkName" desc_key="perkRemsPatientAngler7AfterDarkDesc" long_desc_key="perkRemsPatientAngler7AfterDarkLongDesc">
			<effect_group><!-- effect is in REMS.Fishing: FishingPerks.NightRainBiteFactor --></effect_group>
		</book>
		<!-- *** 7/7 THE_PATIENT_ANGLER_COMPLETE: MASTER_ANGLER -->
		<book name="perkRemsPatientAngler8Complete" parent="skillRemsPatientAngler" max_level="1" base_skill_point_cost="0" name_key="perkRemsPatientAngler8CompleteName" desc_key="perkRemsPatientAngler8CompleteDesc" long_desc_key="perkRemsPatientAngler8CompleteLongDesc">
			<effect_group><!-- effect is in REMS.Fishing: FishingPerks.RareWeightFactor and FishingPerks.WeightFactor --></effect_group>
		</book>
	</append>
	<!-- wip-skill:end -->
</configs>
