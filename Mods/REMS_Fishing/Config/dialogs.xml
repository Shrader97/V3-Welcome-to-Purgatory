<configs>
	<!-- wip-jobs:begin (generated by Tools/merge_wip.py (jobs)) -->
	<!-- Fishing Jobs board (spec 10): one line in the vanilla trader dialogue, just above "Never mind". Every NPC with
	     dialog_id="trader" in npc.xml uses this dialogue (Rekt, Jen, Bob, Hugh, Joel), and so does any other mod's trader
	     built on it, so they all get the line. No buildings or trader prefabs are touched. traderTest is vanilla's test
	     trader. The action is DialogActionREMSFishingJobs in REMS.Fishing.dll (resolved like vanilla's
	     DialogActionTrader: ReflectionHelpers.GetTypeWithPrefix("DialogAction", "REMSFishingJobs, REMS.Fishing")). -->
	<insertBefore xpath="/dialogs/dialog[@id='trader']/statement[@id='start']/response_entry[@id='done']">
		<response_entry id="remsFishingJobs" />
	</insertBefore>
	<append xpath="/dialogs/dialog[@id='trader']">
		<response id="remsFishingJobs" text="remsJobsDialogAsk">
			<action type="REMSFishingJobs, REMS.Fishing" id="open" />
		</response>
	</append>

	<insertBefore xpath="/dialogs/dialog[@id='traderTest']/statement[@id='start']/response_entry[@id='done']">
		<response_entry id="remsFishingJobs" />
	</insertBefore>
	<append xpath="/dialogs/dialog[@id='traderTest']">
		<response id="remsFishingJobs" text="remsJobsDialogAsk">
			<action type="REMSFishingJobs, REMS.Fishing" id="open" />
		</response>
	</append>
	<!-- wip-jobs:end -->
</configs>
