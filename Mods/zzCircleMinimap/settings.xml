<?xml version="1.0" encoding="UTF-8" ?>
<!-- Circle Minimap settings. Positions/sizes are in 1920x1080 reference pixels and scale with your resolution.
     Key names are Unity KeyCode names (F2, PageUp, Keypad5, LeftBracket, ...). Restart the game after editing.
     Easier in game: press the move key (F5) and use the "Key bindings" panel next to the map.
     Position, size and keys you set in game are saved to settings.local.xml and override the values below. -->
<minimap>
	<setting name="CenterX" value="152" />              <!-- map centre, pixels from the left edge -->
	<setting name="CenterY" value="145" />              <!-- map centre, pixels from the top edge -->
	<setting name="Radius" value="112" />               <!-- map radius in pixels -->
	<setting name="BlocksPerRadius" value="96" />       <!-- zoom: blocks (metres) from centre to rim, 32-1024 -->
	<setting name="Opacity" value="0.92" />             <!-- map opacity 0-1 -->
	<setting name="RotateWithPlayer" value="true" />    <!-- true: map turns with your view, arrow points up; false: north always up -->
	<setting name="AutoZoomVehicle" value="true" />     <!-- in a vehicle, zoom out as you speed up and back in as you slow down -->
	<setting name="AutoZoomMax" value="2.5" />          <!-- how far to zoom out at full speed (x times) -->
	<setting name="AutoZoomSpeedMin" value="6" />       <!-- m/s (~22 km/h): no extra zoom below this -->
	<setting name="AutoZoomSpeedMax" value="25" />      <!-- m/s (~90 km/h): full AutoZoomMax from this speed -->
	<setting name="ZoomInKey" value="F2" />
	<setting name="ZoomOutKey" value="F3" />
	<setting name="ZoomInKey2" value="KeypadPlus" />    <!-- second set of zoom keys -->
	<setting name="ZoomOutKey2" value="KeypadMinus" />
	<setting name="ToggleKey" value="Delete" />         <!-- show / hide the minimap -->
	<setting name="MoveKey" value="F5" />               <!-- move mode: drag the map, mouse wheel resizes, rebind keys; press again to save -->
</minimap>
