<configs>

<insertAfter xpath="/nav_object_classes/nav_object_class[@name='animaltracking_wolf']">

	<nav_object_class name="animaltracking_BossGrace" extends="animaltracking_hostile">
		<property name="requirement_type" value="Tracking" />
		<property name="use_override_icon" value="true" />

		<onscreen_settings>
			<property name="offset" value="0,1.75,0"/>
		</onscreen_settings>
	</nav_object_class>

	<nav_object_class name="animaltracking_Zombie" extends="animaltracking_hostile">
		<property name="requirement_type" value="Tracking" />
		<property name="use_override_icon" value="true" />

		<map_settings>
			<property name="sprite_name" value="ui_game_symbol_enemy_dot"/>
			<property name="min_distance" value="0"/>
			<property name="max_distance" value="-1"/>
			<property name="color" value="255,0,0,255"/>
			<property name="has_pulse" value="true"/>
		</map_settings>

		<compass_settings>
			<property name="sprite_name" value="ui_game_symbol_enemy_dot"/>
			<property name="min_distance" value="0"/>
			<property name="max_distance" value="1024"/>
			<property name="max_scale_distance" value="32"/>
			<property name="color" value="255,0,0,255"/>
			<property name="has_pulse" value="true"/>
			<property name="icon_clamped" value="false" />
		</compass_settings>

		<onscreen_settings>
			<property name="sprite_name" value="ui_game_symbol_enemy_dot"/>
			<property name="min_distance" value="0"/>
			<property name="max_distance" value="25"/>
			<property name="color" value="255,0,0,255"/>
			<property name="has_pulse" value="false"/>
			<property name="offset" value="0,1,0"/>
		</onscreen_settings>
	</nav_object_class>

	<nav_object_class name="animaltracking_Fly" extends="animaltracking_hostile">
		<property name="requirement_type" value="Tracking" />
		<property name="use_override_icon" value="true" />

		<map_settings>
			<property name="sprite_name" value="ui_game_symbol_enemy_dot"/>
			<property name="min_distance" value="0"/>
			<property name="max_distance" value="-1"/>
			<property name="color" value="255,0,0,255"/>
			<property name="has_pulse" value="true"/>
		</map_settings>

		<compass_settings>
			<property name="sprite_name" value="ui_game_symbol_enemy_dot"/>
			<property name="min_distance" value="0"/>
			<property name="max_distance" value="1024"/>
			<property name="max_scale_distance" value="32"/>
			<property name="color" value="255,0,0,255"/>
			<property name="has_pulse" value="true"/>
			<property name="icon_clamped" value="false" />
		</compass_settings>

		<onscreen_settings>
			<property name="sprite_name" value="ui_game_symbol_enemy_dot"/>
			<property name="min_distance" value="0"/>
			<property name="max_distance" value="25"/>
			<property name="color" value="255,0,0,255"/>
			<property name="has_pulse" value="false"/>
			<property name="offset" value="0,0,0"/>
		</onscreen_settings>
	</nav_object_class>

</insertAfter>

<insertAfter xpath="/nav_object_classes/nav_object_class[@name='clear_sleeper']/compass_settings">

		<onscreen_settings>
			<property name="sprite_name" value="ui_game_symbol_enemy_dot"/>
			<property name="min_distance" value="0"/>
			<property name="max_distance" value="25"/>
			<property name="color" value="255,0,0,255"/>
			<property name="has_pulse" value="false"/>
			<property name="offset" value="0,1,0"/>
		</onscreen_settings>

</insertAfter>

</configs>
