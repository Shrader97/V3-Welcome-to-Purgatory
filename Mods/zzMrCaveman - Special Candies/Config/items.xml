<configs>

    <append xpath="/items">

        <item name="drugRockCrushers">
            <property name="Extends" value="drugAtomJunkies"/>
            <property name="Meshfile" value="@:Other/Items/Health/pillBottlePrefab.prefab"/>   
            <property name="DropMeshfile" value="@:Other/Items/Misc/sack_droppedPrefab.prefab"/>   
            <property name="CustomIcon" value="drugRockBusters"/>
            <property name="CustomIconTint" value="128,128,128"/>
            <property name="HoldType" value="16"/>
            <property name="DisplayType" value="drugRockCrushers"/>
            <property name="EconomicValue" value="300"/>
            <effect_group tiered="false" name="Candy Tier 1">
                <display_value name="dBoostMelee" value=".2"/>
                <display_value name="dDuration" value="60"/>
                <triggered_effect trigger="onSelfPrimaryActionEnd" action="ModifyCVar" cvar="$buffDrugRockCrushersDuration" operation="add" value="260"/>
                <triggered_effect trigger="onSelfPrimaryActionEnd" action="ModifyCVar" cvar="$buffDrugRockCrushersDuration" operation="set" value="1083">
                    <requirement name="CVarCompare" cvar="$buffDrugRockCrushersDuration" operation="GT" value="1083"/></triggered_effect>
                <triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buffDrugRockCrushers"/>

                <triggered_effect trigger="onSelfPrimaryActionEnd" action="ModifyCVar" cvar="$foodAmountAdd" operation="add" value="5"/>
                <triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buffProcessConsumables"/>
